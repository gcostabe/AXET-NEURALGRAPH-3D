# ── Sources ──────────────────────────────────────────────
# Diretório do HOST montado (read-only) no backend como /data/sources_root.
# Deve ser amplo o suficiente para conter todas as pastas que algum admin
# possa querer indexar — o subcaminho exato é escolhido depois, em runtime,
# pelo painel Admin > Fontes (nunca digitado direto no container).
SOURCES_ROOT=./data/sources

# ── Qdrant (vector DB) ───────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_documents

# ── Postgres (usuários, conversas, auditoria) ────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_local_reef
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=changeme

# ── Embeddings ────────────────────────────────────────────
# local | api
EMBEDDING_MODE=local
EMBEDDING_MODEL_LOCAL=BAAI/bge-m3
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# ── LLM Gateway (Embedado na Solução na Porta 8766) ──────
# openai | anthropic
LLM_PROVIDER=openai
LLM_GATEWAY_URL=http://gateway:8766/codex
LLM_GATEWAY_API_KEY=axet-local-adapter
LLM_MODEL=gpt-5.6-terra-high
GATEWAY_HOST_URL=http://gateway:8766

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=changeme-generate-a-strong-random-secret
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=gcostabe@emeal.nttdata.com

# ── App ───────────────────────────────────────────────────
ENVIRONMENT=local
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000

# ── Base de Conhecimento Oficial (Sincronização em 1 Clique) ──
# Link direto para download do bundle .qpack (GitHub Releases, OneDrive, S3 ou HTTP interno)
KNOWLEDGE_BASE_SYNC_URL=

