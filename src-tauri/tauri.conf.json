{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AXET-NeuralGraph",
  "version": "1.0.0",
  "identifier": "com.nttdata.axet.neuralgraph",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "AXET NeuralGraph 3D - Enterprise Knowledge Assistant (NTT DATA)",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 640,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 210
        },
        "applicationFolderPosition": {
          "x": 460,
          "y": 210
        }
      }
    },
    "windows": {
      "wix": {
        "language": ["pt-BR", "en-US"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
